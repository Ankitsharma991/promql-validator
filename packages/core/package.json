{
  "name": "@promql-validator/core",
  "version": "0.1.0",
  "description": "Framework-agnostic PromQL parser, validator, formatter, and suggestion engine.",
  "license": "MIT",
  "author": "promql-validator contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promql-validator/promql-validator.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/promql-validator/promql-validator/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/promql-validator/promql-validator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "promql",
    "prometheus",
    "validator",
    "parser",
    "monitoring",
    "observability"
  ]
}
