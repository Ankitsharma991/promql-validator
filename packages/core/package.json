{
  "name": "@promql-validator/core",
  "version": "0.1.0",
  "description": "PromQL parser, validator, formatter and autocomplete engine. Framework-agnostic and dependency-free.",
  "license": "MIT",
  "author": {
    "name": "Ankit Sharma",
    "email": "sharmaa7861@gmail.com",
    "url": "https://ankitsharma991.com.np"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ankitsharma991/promql-validator.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ankitsharma991/promql-validator/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Ankitsharma991/promql-validator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "promql",
    "prometheus",
    "parser",
    "validator",
    "linter",
    "formatter",
    "autocomplete",
    "metricsql",
    "victoriametrics",
    "opentelemetry",
    "observability",
    "monitoring"
  ]
}
