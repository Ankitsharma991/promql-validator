{
  "name": "promql-validator",
  "version": "0.1.0",
  "description": "PromQL editor and validator for React and the command line: syntax highlighting, validation, quick fixes and context-aware autocomplete.",
  "license": "MIT",
  "author": {
    "name": "Ankit Sharma",
    "email": "sharmaa7861@gmail.com",
    "url": "https://ankitsharma991.com.np"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "promql-validator": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@promql-validator/core": "0.1.0",
    "@promql-validator/react": "0.1.0"
  },
  "scripts": {
    "build": "tsup && cp ../react/dist/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "promql",
    "prometheus",
    "react",
    "query-editor",
    "validator",
    "linter",
    "cli",
    "autocomplete",
    "metricsql",
    "opentelemetry",
    "observability",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ankitsharma991/promql-validator.git",
    "directory": "packages/meta"
  },
  "homepage": "https://github.com/Ankitsharma991/promql-validator/tree/main/packages/meta#readme",
  "bugs": {
    "url": "https://github.com/Ankitsharma991/promql-validator/issues"
  }
}
