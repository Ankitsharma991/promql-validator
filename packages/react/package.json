{
  "name": "@promql-validator/react",
  "version": "0.1.0",
  "description": "A drop-in, accessible, themeable React PromQL editor with validation and context-aware autocomplete.",
  "license": "MIT",
  "author": "promql-validator contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promql-validator/promql-validator.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/promql-validator/promql-validator/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/promql-validator/promql-validator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": ">=3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    }
  },
  "dependencies": {
    "@promql-validator/core": "0.1.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.10"
  },
  "scripts": {
    "build": "tsup && cp src/theme/styles.css dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "promql",
    "prometheus",
    "react",
    "editor",
    "autocomplete",
    "monitoring"
  ]
}
