{
  "name": "@promql-validator/codemirror",
  "version": "0.1.0",
  "description": "PromQL language support for CodeMirror 6: highlighting, completion and linting, powered by @promql-validator/core.",
  "license": "MIT",
  "author": {
    "name": "Ankit Sharma",
    "email": "sharmaa7861@gmail.com",
    "url": "https://ankitsharma991.com.np"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ankitsharma991/promql-validator.git",
    "directory": "packages/codemirror"
  },
  "homepage": "https://github.com/Ankitsharma991/promql-validator/tree/main/packages/codemirror#readme",
  "bugs": {
    "url": "https://github.com/Ankitsharma991/promql-validator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6",
    "@codemirror/language": ">=6",
    "@codemirror/lint": ">=6",
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6"
  },
  "dependencies": {
    "@promql-validator/core": "0.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/lint": "^6.8.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.6"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "promql",
    "prometheus",
    "codemirror",
    "codemirror6",
    "language",
    "autocomplete",
    "linter",
    "observability"
  ]
}
