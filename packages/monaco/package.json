{
  "name": "@promql-validator/monaco",
  "version": "0.1.0",
  "description": "PromQL language support for Monaco Editor: highlighting, completion and live diagnostics, powered by @promql-validator/core.",
  "license": "MIT",
  "author": {
    "name": "Ankit Sharma",
    "email": "sharmaa7861@gmail.com",
    "url": "https://ankitsharma991.com.np"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ankitsharma991/promql-validator.git",
    "directory": "packages/monaco"
  },
  "homepage": "https://github.com/Ankitsharma991/promql-validator/tree/main/packages/monaco#readme",
  "bugs": {
    "url": "https://github.com/Ankitsharma991/promql-validator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.40.0"
  },
  "dependencies": {
    "@promql-validator/core": "0.1.0"
  },
  "devDependencies": {
    "monaco-editor": "^0.50.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "promql",
    "prometheus",
    "monaco",
    "monaco-editor",
    "language",
    "autocomplete",
    "diagnostics",
    "observability"
  ]
}
